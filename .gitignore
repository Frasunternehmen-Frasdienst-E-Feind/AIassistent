# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Lokale Konfiguration & Geheimnisse (nie committen)
config.yaml
credentials/
.env

# JSON-Dateien: pauschal gesperrt, weil Zugangsdaten (Google-Service-Account-
# Schlüssel, Tokens, Exporte) meist als .json vorliegen.
# Ausnahmen NUR hier eintragen, je mit Grund – nie per `git add -f` umgehen.
# Eine Ausnahme darf keine Zugangsdaten und keine personenbezogenen Daten
# enthalten (siehe CLAUDE.md, Abschnitt Datenschutz).
*.json
# npm-Manifest und Lockfile (reproduzierbare Installation, CI nutzt npm ci)
!package.json
!package-lock.json
# MCP-Server-Registrierung: nur Paketname und Version
!.mcp.json
# Hook-Registrierung für Claude Code: nur ein Dateipfad
!.claude/settings.json
# Corporate-Design-Tokens: einzige Quelle für Farben/Schriften laut CLAUDE.md
!branding/feind-ci.tokens.json
# Messwerte des visuellen Umbaus (Cockpit), bewusst versioniert
!messe/rotterdam-2027/umbau/*.json
# Plugin-Manifest und Connector-Datei des Marketing Cockpits (keine Geheimnisse)
!feind-marketing-cockpit/.claude-plugin/plugin.json
!feind-marketing-cockpit/.mcp.json
# Messe-Generator: Inhalte und Team-Vorlage (ohne echte Personendaten)
!messe/content/**/*.json
!messe/data/team.example.json

# Rohdaten mit möglichen personenbezogenen Daten (DSGVO)
data/crm/*
!data/crm/.gitkeep
!data/crm/leads.example.csv

# Generierte Reports
output/*
!output/.gitkeep

# Deep-Research-Deliverables (liegen im Arbeitsverzeichnis, damit die App sie
# öffnen kann; sind Session-Ergebnisse, keine Repo-Quellen)
research_notes/
reports/

# Build-Artefakte
build/
dist/

# Plugin-Paket (wird mit build-zip.sh erzeugt)
*.zip

# Node-Abhängigkeiten (npm install)
node_modules/

test-results/
playwright-report/

# Personenbezogene Daten & generierte Dokumente NIE committen (DSGVO):
messe/data/*.local.json
messe/output/*
!messe/output/.gitkeep
