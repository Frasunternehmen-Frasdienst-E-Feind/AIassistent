# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Lokale Konfiguration & Geheimnisse (nie committen)
config.yaml
credentials/
*.json
!config.schema.json
!.mcp.json
# Plugin-Manifest und Connector-Datei des Marketing Cockpits (keine Geheimnisse)
!feind-marketing-cockpit/.claude-plugin/plugin.json
!feind-marketing-cockpit/.mcp.json
# Hook-Registrierung für Claude Code; enthält nur einen Dateipfad,
# keine Zugangsdaten.
!.claude/settings.json
.env

# Rohdaten mit möglichen personenbezogenen Daten (DSGVO)
data/crm/*
!data/crm/.gitkeep
!data/crm/leads.example.csv

# Generierte Reports
output/*
!output/.gitkeep

# Build-Artefakte
build/
dist/

# Plugin-Paket (wird mit build-zip.sh erzeugt)
*.zip
