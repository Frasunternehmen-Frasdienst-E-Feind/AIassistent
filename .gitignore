# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Lokale Konfiguration & Geheimnisse (nie committen)
config.yaml
credentials/
*.json
!config.schema.json
!.mcp.json
# Hook-Registrierung für Claude Code; enthält nur einen Dateipfad,
# keine Zugangsdaten.
!.claude/settings.json
.env

# Rohdaten mit möglichen personenbezogenen Daten (DSGVO)
data/crm/*
!data/crm/.gitkeep
!data/crm/leads.example.csv

# Generierte Reports
output/*
!output/.gitkeep

# Build-Artefakte
build/
dist/
node_modules/
test-results/
playwright-report/

# Messe-Generator: versionierte Inhalte & Vorlagen wieder einschließen
# (das globale *.json oben würde sie sonst ausschließen)
!messe/content/**/*.json
!messe/data/team.example.json
# Personenbezogene Daten & generierte Dokumente NIE committen (DSGVO):
messe/data/*.local.json
messe/output/*
!messe/output/.gitkeep

# Node-Abhängigkeiten (npm install)
