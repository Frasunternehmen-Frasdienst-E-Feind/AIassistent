# =============================================================================
# .env-Vorlage — Fräsdienst-Service E. Feind GmbH / AIassistent
# -----------------------------------------------------------------------------
# Kopieren nach ".env" und mit echten Werten füllen:
#     cp .env.example .env
#
# WICHTIG (DSGVO / Sicherheit):
#   - Die echte ".env" ist per .gitignore vom Versionskontroll-System ausgeschlossen
#     und darf NIEMALS committet werden. Nur diese Vorlage (.env.example) wird versioniert.
#   - Keine Geheimnisse (Passwörter, Service-Account-JSON) im Repository ablegen.
#   - Werte mit Personenbezug nur mit Rechtsgrundlage/Einwilligung verarbeiten.
#     Bei rechtlichen/vertraglichen Fragen: Bitte Rechtsabteilung prüfen.
# =============================================================================


# =============================================================================
# A) SEO-/LEAD-REPORTING-DIENST (seo_reporting)
#    Diese Variablen werden vom Code gelesen und überschreiben die Werte aus
#    config.yaml (siehe seo_reporting/config.py und docs/SETUP.md).
# =============================================================================

# Pfad zur Konfigurationsdatei (Alternative zu --config / config.yaml im CWD).
SEO_REPORTING_CONFIG="config.yaml"

# Google Search Console Property.
#   Domain-Property:   "sc-domain:fraesdienst-feind.de"
#   oder URL-Präfix:   "https://www.fraesdienst-feind.de/"
GSC_SITE_URL="sc-domain:fraesdienst-feind.de"

# GA4 Property-ID (nur Ziffern; GA4 Admin -> Property-Einstellungen).
GA4_PROPERTY_ID=""

# Google-Service-Account — EINE der beiden Varianten setzen:
#   1) Pfad zur JSON-Schlüsseldatei (Datei liegt außerhalb des Repos / in credentials/)
GOOGLE_APPLICATION_CREDENTIALS="credentials/service-account.json"
#   2) ODER Service-Account-JSON direkt als Inhalt (z. B. in CI-Secrets; Vorrang vor 1)
#      Einzeilig einfügen; nicht committen!
# GOOGLE_SERVICE_ACCOUNT_JSON=

# CRM-Export (CSV/XLSX) — nur Datum/Quelle/Status/Wert, KEINE personenbezogenen Daten.
CRM_EXPORT_PATH="data/crm/leads.csv"

# Ausgabeverzeichnis für generierte Reports.
REPORT_OUTPUT_DIR="output"

# --- E-Mail-Versand (optional; nur für `seo-report ... --email`) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
# Passwort AUSSCHLIESSLICH hier/als ENV setzen, niemals in config.yaml.
SMTP_PASSWORD=""
# Absender-Adresse.
REPORT_EMAIL_FROM=""
# Empfänger, kommagetrennt (z. B. "david@fd-ef.com, gf@fd-ef.com").
REPORT_EMAIL_TO=""


# =============================================================================
# B) DATENSCHUTZBERICHT — Berichtsvariablen
#    Speisen die Platzhalter des Datenschutzberichts
#    (docs/datenschutz/datenschutzbericht.md, Abschnitt 0 + Anhang R).
#    Leer/nicht gesetzt => im Bericht als {{PLATZHALTER}} bzw. "Offene Frage".
# =============================================================================

# --- Verantwortlicher (Art. 4 Nr. 7 DSGVO) ---
COMPANY_NAME="Fräsdienst-Service E. Feind GmbH"
COMPANY_ADDRESS=""
COMPANY_MANAGING_DIRECTOR=""
CONTACT_EMAIL=""
CONTACT_PHONE=""
VAT_ID=""
# Datenschutzbeauftragte(r), falls benannt (sonst leer lassen).
DPO_CONTACT=""

# --- Website / Hosting ---
# Hosting-Anbieter -> Auftragsverarbeiter (Art. 28) + Serverstandort/Drittland (Art. 44 ff.).
HOSTING_PROVIDER=""
# Content-Management-System (z. B. WordPress, TYPO3, Jimdo).
CMS=""
# Aufbewahrungsdauer Server-Logs (z. B. "7 Tage", "30 Tage").
LOG_RETENTION=""
# GA4-Aufbewahrungsdauer (z. B. "2 Monate", "14 Monate").
GA4_RETENTION=""

# --- Dienste & Integrationen (kommagetrennte Listen) ---
# Alle Drittdienste mit möglichem Datenzugriff -> AVV-/Drittstaatenprüfung.
THIRD_PARTY_SERVICES=""
# APIs / Webhooks / Zapier etc.
INTEGRATIONS=""
# Newsletter-Tool (Einwilligung, Double-Opt-in, AVV).
NEWSLETTER_TOOL=""
# Zahlungsdienstleister.
PAYMENT_PROVIDER=""
# Lohnabrechnung / Payroll-Dienstleister.
PAYROLL_PROVIDER=""
# IT-Dienstleister / Fernwartung.
IT_SUPPORT=""

# --- Datensicherung ---
# Backup-Lösung und Aufbewahrung (Löschkonzept, Art. 5 Abs. 1 lit. e).
BACKUP_SOLUTION=""
BACKUP_RETENTION=""

# --- Aufsichtsbehörde ---
# Hauptsitz Lübben (Brandenburg) -> i. d. R. LDA Brandenburg; Niederlassung
# Wittenburg (Mecklenburg-Vorpommern) ggf. LfDI M-V (Zuständigkeit bei Meldung verifizieren).
SUPERVISORY_AUTHORITY="LDA Brandenburg"
